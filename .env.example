# Server-only. Free key from https://explore.openaq.org (account settings).
# Without it, measured data fails closed and only the labelled forecast is shown.
OPENAQ_API_KEY=

# Server-only. Gemini API key (Google AI Studio). Without it, the daily plan
# shows a generic retry message; everything else on the page still works.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
